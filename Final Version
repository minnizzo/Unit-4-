def validation(columns):
    #Checks if the data from the file meet the validation rules. Returns True if it is valid and False if it is invalid.
    try:
        vendor_id = columns[0]
        name = columns[1]
        date = columns[2]
        vegan = int(columns[3])
        meat = int(columns[4])
        onions = float(columns[5])
        ketchup = int(columns[6])

        #ID format: Has to be 6 characters long and start with two capital letters, includes an underscore and has three digits (e.g: NC_127)
        if not (len(vendor_id) == 6 and vendor_id[:2].isupper() and vendor_id[2] == "_" and vendor_id[3:].isdigit()):
            return False
        
        #Name length: Has to be between 2 and 25 characters long.
        if not(2 <= len(name) <= 25):
            return False
        
        #Date format + week: The date has to be exactly 6 digits. 
        if not(len(date) == 6 and date.isdigit()):
            return False
        
        #Multiples of 10: Hotdogs have to be divisable by 10.
        if vegan % 10 != 0 or meat % 10 != 0:
            return False
        
        #Onions: It checks if the onions are in the correct format.
        if onions * 2 != int(onions * 2):
            return False
        
        #Ketchup: Has to be between 1 and 4 litres.
        if not (1 <= ketchup <= 4):
            return False

        return True #If it is valid
    except:
        return False #If the data type is wrong. e.g: text where a number should be.
        


def data_loading(hotdogs_file):
    #Opens the text file ("Hotdogs.txt") and adds valid records into a list of dictionaries
    
    vendor_list = []
    
    try:
        #Using a with function to make sure the file closes automatically.
        with open(hotdogs_file,"r") as file:
            for line in file:
                #Removes blank spaces and splits the values which have a comma in between.
                columns = line.strip().split(",")
                columns = [item.strip() for item in columns]

                
                #If the row has 7 items and passes the validation
                if len(columns) == 7 and validation(columns):
                    try:
                        records = {
                            "id": columns[0],
                            "name": columns[1],
                            "date": columns[2],
                            "vegan": int(columns[3]),
                            "meat": int(columns[4]),
                            "onions": float(columns[5]),
                            "ketchup": int(columns[6])
                        }
                        vendor_list.append(records)
                    except:
                        print("Invalid record.",columns)
                else:
                    print("Invalid record",columns)
            
            print("Loaded", len(vendor_list), "vendors.")
            return vendor_list
        
    except FileNotFoundError:
        print("Error: 'Hotdogs.txt' not found")
        return []
    

