def quick_sort(data_list):
    #A divide and conquer sorting algorithm
    
    if len(data_list) <= 1:
        return data_list
    
    pivot = data_list[0]
    #Splits the list into items smaller than the pivot and items larger.
    left = [x for x in data_list[1:] if x['name'].lower()< pivot['name'].lower()]
    right = [x for x in data_list[1:] if x['name'].lower() >= pivot['name'].lower()]
    return quick_sort(left) + [pivot] + quick_sort(right)

def bubble_sort(data):
    #A simple sorting algorithm.
    
    x = len(data)

    for i in range(x):
        for m in range(0,x - i - 1):

            if data[m]["name"].lower() > data[m+1]["name"].lower():
               data[m], data[m+1] = data [m+1], data[m]

def binarySearch(data_list, x):
    #Fast search for sorted lists. Halves the search area.
    low = 0
    high = len(data_list) - 1
    x = x.lower()
    
    while low <= high:
        mid = low + (high - low) // 2
        current_name = data_list[mid]["name"].lower()
        
        if current_name == x:
            return mid
        elif current_name < x:
            low = mid + 1
        else:
            high = mid - 1
            
    return -1



#linear search (unsorted)

def linearSearchUnsorted (data, search_name):
    #Checks every single item one by one. This specifically works on unsorted data.
    
    for i in range(len(data)):
        #Checks if the name is in the list
        if data[i]["name"].lower() == search_name.lower():
            #
            return i, data[i]
    
    return -1, None
    #This is for the loop if it finishes without finding anything.

def linearSearchSorted(data, search_name):
    #This version of the linear search stops early if it passes where the name should.
    search_name = search_name.strip().lower()
    matches = []
    for i in range(len(data)):
        name1 = data[i]["name"].lower()
        if name1 == search_name:
            matches.append(data[i])
        elif name1 > search_name:
            break
    return matches

def analysing_data(data):
    #Calculates the totals and find the best/worst vendors.
    
    most = data[0]
    least_ketchup_used = data[0]
    total_vegan = 0
    total_meat = 0

    for b in data:
        #Checks for the highest total sales.
        if b["vegan"] + b["meat"] > most["vegan"] + most["meat"]:
            most = b
        #Checks for the vendor who uses the least amount of ketchup
        if b["ketchup"] < least_ketchup_used["ketchup"]:
            least_ketchup_used = b

        total_vegan += b["vegan"]
        total_meat += b["meat"]

    print("Analysis\n")
    print("--------\n")
    print("")
    print("Most productive:", most["name"])
    print("Total vegan:", total_vegan)
    print("Total meat:", total_meat)
    print("Least ketchup:", least_ketchup_used["name"])

    return {
        "most": most,
        "vegan": total_vegan,
        "meat": total_meat,
        "least": least_ketchup_used
        }

