def binarySearch(data_list, x):
    low = 0
    high = len(data_list) - 1
    while low <= high:
        mid = low + (high - low) // 2
        if data_list[mid] == x:
            return mid
        elif data_list[mid] < x:
            low = mid + 1
        else:
            high = mid - 1
    return -1
