def binarySearch(data_list, x):
    low = 0
    high = len(data_list) - 1
    while low <= high:

        mid = low + (high - low) // 2

        # Check if x is present at mid
        if data_list[mid] == x:
            return mid

        # If x is greater, ignore left half
        elif data_list[mid] < x:
            low = mid + 1

        # If x is smaller, ignore right half
        else:
            high = mid - 1

    # If we reach here, then the element
    # was not present
    return -1

