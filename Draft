                    "meat": int(columns[4]),
                    "onions": float(columns[5]),
                    "ketchup": int(columns[6])
                }
                vendor_list.append(records)
        print("Loaded", len(vendor_list),"vendors.")
        return vendor_list
    
    except FileNotFoundError:
        print("Error detected: The file Hotdogs.txt was not found.")
        return []


def quick_sort(data_list):
    if len(data_list) <= 1:
        return data_list
    
    pivot = data_list[0]
    
    left = [x for x in data_list[1:] if x['name'].lower()< pivot['name'].lower()]
    right = [x for x in data_list[1:] if x['name'].lower() >= pivot['name'].lower()]
    return quick_sort(left) + [pivot] + quick_sort(right)

def bubble_sort(data):
    x = len(data)

    for i in range(x):
        for m in range(0,x - i - 1):

            if data[m]["name"].lower() > data[m+1]["name"].lower():
               data[m], data[m+1] = data [m+1], data[m]

def binarySearch(data_list, x):
    low = 0
    high = len(data_list) - 1
    while low <= high:
        mid = low + (high - low) // 2
        if data_list[mid] == x:
            return mid
        elif data_list[mid] < x:
            low = mid + 1
        else:
            high = mid - 1
            
    return -1



