def data_loading(hotdogs_file):
    vendor_list = []
    try:
        with open("Hotdogs.txt","r") as file:
            for line in file:
                columns = line.strip().split(",")
                columns = [item.strip() for item in columns]
            
                if len(columns) == 7:
                    records = {
                    "id": columns[0],
                    "name": columns[1],
                    "date": columns[2],
                    "vegan": int(columns[3]),
                    "meat": int(columns[4]),
                    "onions": float(columns[5]),
                    "ketchup": int(columns[6])
                }
                vendor_list.append(records)
        print("Loaded", len(vendor_list),"vendors.")
        return vendor_list
    
    except FileNotFoundError:
        print("Error detected: The file Hotdogs.txt was not found.")
        return []


def quick_sort(data_list):
    if len(data_list) <= 1:
        return data_list
    
    pivot = data_list[0]
    
    left = [x for x in data_list[1:] if x['name'].lower()< pivot['name'].lower()]
    right = [x for x in data_list[1:] if x['name'].lower() >= pivot['name'].lower()]
    return quick_sort(left) + [pivot] + quick_sort(right)

def bubble_sort(data):
    x = len(data)

    for i in range(x):
        for m in range(0,x - i - 1):

            if data[m]["name"].lower() > data[m+1]["name"].lower():
               data[m], data[m+1] = data [m+1], data[m]

def binarySearch(data_list, x):
    low = 0
    high = len(data_list) - 1
    x = x.lower()
    
    while low <= high:
        mid = low + (high - low) // 2
        current_name = data_list[mid]["name"].lower()
        
        if current_name == x:
            return mid
        elif current_name < x:
            low = mid + 1
        else:
            high = mid - 1
            
    return -1



